.venv/
__pycache__/
*.pyc
data/outputs/*
!data/outputs/youtube/
!data/outputs/youtube/**

# Only these specific tiktok/news files are public -- everything else in
# these directories (browser profile, spike dumps, other batches) stays
# gitignored. A directory that's ignored won't be traversed for negation
# patterns targeting files inside it, so each directory must be re-included
# before re-ignoring its contents and allowlisting specific files.
!data/outputs/tiktok/
data/outputs/tiktok/*
!data/outputs/tiktok/tiktok_discovery_20260726_1715.csv
!data/outputs/tiktok/tiktok_20260726_1737.jsonl
!data/outputs/tiktok/tiktok_20260726_1737.csv

!data/outputs/news/
data/outputs/news/*
!data/outputs/news/discovery_news_20260726_2049.csv
!data/outputs/news/news_20260726_2108.jsonl
!data/outputs/news/news_20260726_2108.csv

data/inputs/*
!data/inputs/tiktok/
data/inputs/tiktok/*
!data/inputs/tiktok/urls.txt

!data/inputs/news/
data/inputs/news/*
!data/inputs/news/urls.txt

.env
.secrets/
data/outputs/baseline_gate_v2/
data/outputs/facebook/
