.venv/
__pycache__/
*.pyc
data/outputs/*
!data/outputs/youtube/
!data/outputs/youtube/**

# Only these specific tiktok/news files are public -- everything else in
# these directories (browser profile, spike dumps, other batches) stays
# gitignored. A directory that's ignored won't be traversed for negation
# patterns targeting files inside it, so each directory must be re-included
# before re-ignoring its contents and allowlisting specific files.
!data/outputs/tiktok/
data/outputs/tiktok/*
!data/outputs/tiktok/tiktok_flood_discovery_20260924_2120.csv
!data/outputs/tiktok/tiktok_flood_discovery_20260924_2241.csv
!data/outputs/tiktok/tiktok_flood_20260924_2307.jsonl
!data/outputs/tiktok/tiktok_flood_20260925_0900.jsonl

!data/outputs/news/
data/outputs/news/*
!data/outputs/news/discovery_news_flood_20260924_2302.csv
!data/outputs/news/discovery_news_flood_20260924_2304.csv
!data/outputs/news/news_flood_20260925_1411.jsonl
!data/outputs/news/news_flood_20260925_1734.jsonl

data/inputs/*
!data/inputs/tiktok/
data/inputs/tiktok/*
!data/inputs/tiktok/urls_20260924_2120.csv
!data/inputs/tiktok/urls_20260924_2241.csv

!data/inputs/news/
data/inputs/news/*
!data/inputs/news/urls_20260924_2302.csv
!data/inputs/news/urls_20260924_2304.csv

.env
.secrets/
crawl.db
data/outputs/baseline_gate_v2/
data/outputs/facebook/
